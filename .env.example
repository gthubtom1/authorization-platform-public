# Local-only example. Copy to .env when needed; never commit real values.
APP_ENV=local
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-this-local-only-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8123,http://localhost:8123
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_REFERRER_POLICY=same-origin

# Only set proxy values when a trusted reverse proxy is the direct peer.
# Production must use explicit proxy CIDRs and a shared cache backend.
TRUSTED_PROXY_IPS=
TRUST_PROXY_SSL_HEADER=false
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=authorization-platform-local-rate-limit
AUTHORIZATION_PLATFORM_WORKERS=1
DATABASE_CONN_MAX_AGE=60

# Backup/disaster-recovery contract. Local/test runs may leave these empty;
# production settings fail closed until the pgBackRest + WAL + two-repository
# contract is supplied by the deployment secret/configuration store.
BACKUP_PROVIDER=
BACKUP_STANZA=
BACKUP_REPOSITORY_COUNT=0
BACKUP_REPOSITORY_1=
BACKUP_REPOSITORY_2=
BACKUP_REPOSITORIES_INDEPENDENT=false
BACKUP_ENCRYPTION=
BACKUP_CIPHER_PASSWORD_FILE=
BACKUP_REMOTE_TLS=false
BACKUP_WAL_ARCHIVING=
BACKUP_ARCHIVE_COMMAND_CONFIGURED=false
BACKUP_RETENTION_FULL=0
BACKUP_RETENTION_DIFF=0
BACKUP_RETENTION_ARCHIVE=0
BACKUP_RPO_MINUTES=0
BACKUP_RTO_MINUTES=0
BACKUP_STATUS_FILE=
BACKUP_FAILURE_ALERTING=false
BACKUP_FAILURE_HANDLER=
BACKUP_WARN_FREE_PERCENT=25
BACKUP_CRITICAL_FREE_PERCENT=15

# In local development this may be omitted; the app derives a key from the local secret.
# In production it must be a separate Fernet key kept outside the repository.
# INVITATION_ENCRYPTION_KEY=replace-with-generated-fernet-key
# PASSWORD_OPERATION_HASH_KEY=replace-with-a-separate-hmac-key
# ACCOUNT_OPERATION_HASH_KEY=replace-with-a-separate-hmac-key
# QUOTA_CARD_HASH_KEY=replace-with-a-separate-hmac-key
# QUOTA_CARD_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
# QUOTA_CARD_ENCRYPTION_KEY_VERSION=v2
# QUOTA_CARD_LEGACY_ENCRYPTION_KEY=replace-with-the-managed-v1-fernet-key-when-old-rows-exist
# QUOTA_CARD_LEGACY_ENCRYPTION_KEY_VERSION=v1
# QUOTA_REDEEM_IP_HASH_KEY=replace-with-a-separate-hmac-key
# LICENSE_CARD_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
# LICENSE_CARD_HASH_KEY=replace-with-a-separate-hmac-key
INVITATION_DEFAULT_TTL_SECONDS=86400
INVITATION_MAX_ATTEMPTS=5
INVITATION_MAX_BATCH_SIZE=1000
INVITATION_ISSUE_TOKEN_TTL_SECONDS=900
INVITATION_REVEAL_RATE_LIMIT=20
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_LICENSE_RATE_LIMIT=120
QUOTA_REDEEM_RATE_LIMIT=10
QUOTA_CARD_REVEAL_RATE_LIMIT=20
QUOTA_CARD_MAX_BATCH_SIZE=1000
QUOTA_CARD_MAX_AMOUNT=1000000000
QUOTA_REDEEM_IP_HASH_KEY=replace-with-a-separate-hmac-key
LICENSE_CARD_MAX_BATCH_SIZE=1000
LICENSE_CARD_MAX_TOTAL_COST=1000000000
LICENSE_CARD_PREVIEW_TTL_SECONDS=600
LICENSE_CARD_REVEAL_RATE_LIMIT=20
LICENSE_CARD_PREVIEW_RATE_LIMIT=30
LICENSE_CARD_ISSUE_RATE_LIMIT=20
LICENSE_CARD_SEARCH_RATE_LIMIT=30
LICENSE_CARD_RECLAIM_RATE_LIMIT=20
LICENSE_CARD_EXPORT_RATE_LIMIT=10
# Required in production only when legacy v1 card rows still need reading.
# LICENSE_CARD_LEGACY_ENCRYPTION_KEY=replace-with-managed-legacy-fernet-key

# PR-07 authorization signing. Keep the private key outside the repository;
# local development may omit it and use a deterministic test-only fallback.
# AUTHORIZATION_SIGNING_PRIVATE_KEY=base64url-encoded-32-byte-ed25519-seed
# AUTHORIZATION_SIGNING_KEY_ID=platform-key-v1
# AUTHORIZATION_NONCE_HASH_KEY=replace-with-a-separate-hmac-key
# AUTHORIZATION_DEVICE_HASH_KEY=replace-with-a-separate-hmac-key
# AUTHORIZATION_SIGNING_PRIVATE_KEY=base64url-encoded-32-byte-ed25519-seed
# AUTHORIZATION_SIGNING_KEY_ID=platform-key-v1

# Local object storage is an atomic filesystem adapter for tests only.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PATH_STYLE=false
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# sqlite is the default for the first local startup.
DATABASE_ENGINE=sqlite
# DATABASE_NAME=local.sqlite3

# Set DATABASE_ENGINE=postgresql for the second local verification.
# DATABASE_NAME=authorization_platform
# DATABASE_USER=authorization_platform
# DATABASE_PASSWORD=replace-local-password
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DJANGO_CACHE_TIMEOUT=300

# Production baseline (inject through the deployment secret/config store; do not
# copy real values into this file):
# APP_ENV=production
# DJANGO_DEBUG=false
# ALLOWED_HOSTS=auth.example.com
# CSRF_TRUSTED_ORIGINS=https://auth.example.com
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# TRUSTED_PROXY_IPS=10.0.0.0/8
# TRUST_PROXY_SSL_HEADER=true
# DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# DJANGO_CACHE_LOCATION=django_cache
# AUTHORIZATION_PLATFORM_WORKERS=2
# DATABASE_CONN_MAX_AGE=60
# OBJECT_STORAGE_PROVIDER=s3-compatible
# OBJECT_STORAGE_ENDPOINT=https://objects.example.com
# OBJECT_STORAGE_BUCKET=authorization-platform
# OBJECT_STORAGE_REGION=region-1
# OBJECT_STORAGE_ACCESS_KEY_ID=managed-access-key
# OBJECT_STORAGE_SECRET_ACCESS_KEY=managed-secret
# OBJECT_STORAGE_PATH_STYLE=false
# RELEASE_SIGNING_PUBLIC_KEY=managed-ed25519-public-key
# RELEASE_SIGNING_KEY_ID=release-prod-2026-01
