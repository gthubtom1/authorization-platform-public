# Generate a root-readable runtime copy from this review template. Do not
# commit the filled file: S3 credentials and cipher passwords are secrets.

[global]
repo1-type=s3
repo1-path=/authorization-platform
repo1-s3-bucket=authorization-platform-backup-primary
repo1-s3-endpoint=<primary-s3-endpoint>
repo1-s3-region=<primary-s3-region>
repo1-s3-key=<injected-primary-backup-key>
repo1-s3-key-secret=<injected-primary-backup-secret>
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=<injected-from-secret-store>
repo1-retention-full=7
repo1-retention-diff=14
repo1-retention-archive=14

repo2-type=s3
repo2-path=/authorization-platform
repo2-s3-bucket=authorization-platform-backup-secondary
repo2-s3-endpoint=<secondary-s3-endpoint>
repo2-s3-region=<secondary-s3-region>
repo2-s3-key=<injected-secondary-backup-key>
repo2-s3-key-secret=<injected-secondary-backup-secret>
repo2-cipher-type=aes-256-cbc
repo2-cipher-pass=<injected-from-secret-store>
repo2-retention-full=7
repo2-retention-diff=14
repo2-retention-archive=14

archive-async=y
compress-type=zst
process-max=2
spool-path=/var/spool/pgbackrest
start-fast=y

[authorization-platform]
pg1-path=/var/lib/postgresql/data
