# 本文件只给本机校验格式。任何 VPS / 候选 / 测试授权平台禁止按下面的 replace-with 生成新密钥。
# 必须注入 部署与恢复/灾备钥匙包 里已定死的那一套（ADR-0015）。
APP_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret-value
ALLOWED_HOSTS=auth.example.com
CSRF_TRUSTED_ORIGINS=https://auth.example.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
TRUSTED_PROXY_IPS=127.0.0.1/32
TRUST_PROXY_SSL_HEADER=true
DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
DJANGO_CACHE_LOCATION=django_cache
AUTHORIZATION_PLATFORM_WORKERS=2
DATABASE_ENGINE=postgresql
DATABASE_NAME=authorization_platform
DATABASE_USER=authorization_platform
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=db
DATABASE_PORT=5432
INVITATION_ENCRYPTION_KEY=replace-with-a-unique-fernet-key
PASSWORD_OPERATION_HASH_KEY=replace-with-a-unique-hmac-key
ACCOUNT_OPERATION_HASH_KEY=replace-with-a-unique-hmac-key
QUOTA_CARD_HASH_KEY=replace-with-a-unique-hmac-key
QUOTA_REDEEM_IP_HASH_KEY=replace-with-a-unique-hmac-key
QUOTA_CARD_ENCRYPTION_KEY=replace-with-a-unique-fernet-key
QUOTA_CARD_ENCRYPTION_KEY_VERSION=v2
# Required while any existing v1 quota-card rows remain. Remove only after
# the isolated rotation and restore evidence prove that no v1 rows remain.
QUOTA_CARD_LEGACY_ENCRYPTION_KEY=replace-with-managed-v1-fernet-key
QUOTA_CARD_LEGACY_ENCRYPTION_KEY_VERSION=v1
LICENSE_CARD_HASH_KEY=replace-with-a-unique-hmac-key
LICENSE_CARD_ENCRYPTION_KEY=replace-with-a-unique-fernet-key
AUTHORIZATION_NONCE_HASH_KEY=replace-with-a-unique-hmac-key
AUTHORIZATION_DEVICE_HASH_KEY=replace-with-a-unique-hmac-key
AUTHORIZATION_SIGNING_PRIVATE_KEY=replace-with-a-managed-ed25519-seed
AUTHORIZATION_SIGNING_KEY_ID=platform-prod-v1
RELEASE_SIGNING_PUBLIC_KEY=replace-with-a-managed-ed25519-public-key
RELEASE_SIGNING_KEY_ID=replace-with-managed-release-key-id
RELEASE_REQUIRE_VERIFIED_SIGNATURE=true
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=https://object-store:9000
OBJECT_STORAGE_CA_CERT=/app/object-store-ca.crt
OBJECT_STORAGE_BUCKET=authorization-platform
OBJECT_STORAGE_REGION=internal-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-a-dedicated-object-user
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-dedicated-object-secret
OBJECT_STORAGE_PATH_STYLE=true

# Disaster recovery: these are non-secret identifiers only. Credentials and
# the pgBackRest cipher password must come from the deployment secret store.
BACKUP_PROVIDER=pgbackrest
BACKUP_STANZA=authorization-platform
BACKUP_REPOSITORY_COUNT=2
BACKUP_REPOSITORY_1=s3://authorization-platform-backup-primary/authorization-platform
BACKUP_REPOSITORY_2=s3://authorization-platform-backup-secondary/authorization-platform
BACKUP_REPOSITORY_FAILURE_DOMAIN_1=primary-backup-provider
BACKUP_REPOSITORY_FAILURE_DOMAIN_2=secondary-backup-provider
BACKUP_REPOSITORIES_INDEPENDENT=true
BACKUP_ENCRYPTION=aes-256-cbc
BACKUP_CIPHER_PASSWORD_FILE=/run/secrets/authorization-platform-pgbackrest-cipher-pass
BACKUP_REMOTE_TLS=true
BACKUP_WAL_ARCHIVING=on
BACKUP_ARCHIVE_COMMAND_CONFIGURED=true
BACKUP_RETENTION_FULL=7
BACKUP_RETENTION_DIFF=14
BACKUP_RETENTION_ARCHIVE=14
BACKUP_RPO_MINUTES=15
BACKUP_RTO_MINUTES=60
BACKUP_ROOT=/var/lib/authorization-platform-backup
BACKUP_KEYS_DIR=/var/lib/authorization-platform-backup/keys
BACKUP_STATUS_FILE=/var/lib/authorization-platform-backup/backup-status.json
BACKUP_DOWNLOAD_DIR=/var/lib/authorization-platform-backup/downloads
BACKUP_LOG_FILE=/var/lib/authorization-platform-backup/backup.log
BACKUP_SCHEDULE_STAMP_DIR=/var/lib/authorization-platform-backup/backup-stamps
BACKUP_DUMP_PASS_FILE=/var/lib/authorization-platform-backup/host-secrets/github-dump-pass.txt
BACKUP_PROOF_FILE=/var/lib/authorization-platform-backup/backup-proof.json
BACKUP_PROOF_GENERATOR=/srv/authorization-platform/scripts/backup_proof_generator.py
BACKUP_EVIDENCE_COLLECTOR=/srv/authorization-platform/scripts/backup_evidence_collector.py
# Must list object-store keys. A PostgreSQL data-directory listing is not a valid object manifest.
BACKUP_OBJECT_STORAGE_LIST=
BACKUP_MIGRATION_GRAPH_FILE=/var/lib/authorization-platform-backup/migration-graph.json
BACKUP_CANDIDATE_COMMIT=replace-with-deployed-git-sha
BACKUP_KEY_VERSIONS=license-card:v2,quota-card:v2
PUBLIC_RELEASE_DOWNLOAD_RATE_LIMIT=3
PUBLIC_RELEASE_DOWNLOAD_IP_RATE_LIMIT=100
PUBLIC_RELEASE_DOWNLOAD_WINDOW_SECONDS=1800
RELEASE_DOWNLOAD_REQUIRE_AUTH=false
DISABLE_LEGACY_BATCH_VIEWS=true
# systemd 模板默认 /srv/authorization-platform。当前测试候选若仍在 rc8 目录，改成该 manage.py 及其 venv。
PYTHON_BIN=/srv/authorization-platform/.venv/bin/python
AUTHORIZATION_PLATFORM_MANAGE=/srv/authorization-platform/manage.py
AUTHORIZATION_PLATFORM_DB_CONTAINER=authorization-platform-candidate-380c59a-db-1
BACKUP_GITHUB_REPO=gthubtom1/authorization-platform-backup
BACKUP_FAILURE_ALERTING=true
BACKUP_FAILURE_HANDLER=/usr/local/sbin/authorization-platform-backup-alert
BACKUP_WARN_FREE_PERCENT=25
BACKUP_CRITICAL_FREE_PERCENT=15
