{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authorization-a.local/schema/a-core.v1.schema.json",
  "title": "Authorization A local core contract",
  "description": "Language-neutral snapshot and module envelope exchanged between Authorization A and a product adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "product_id",
    "snapshot_id",
    "subject_id",
    "device_id",
    "license_state",
    "issued_at",
    "expires_at",
    "capabilities",
    "modules"
  ],
  "properties": {
    "protocol": {
      "const": "a-core.v1"
    },
    "product_id": {
      "$ref": "#/$defs/identifier"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "license_state": {
      "enum": ["active", "grace", "expired", "revoked", "blocked", "not_modified", "unavailable"]
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "product_id", "module_id", "version", "capability", "payload"],
      "properties": {
        "protocol": {
          "const": "a-core.v1"
        },
        "product_id": {
          "$ref": "#/$defs/identifier"
        },
        "module_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "payload": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  }
}
