# Included in nginx http context. Substitute only __DOMAIN__ and __TLS_CERT_NAME__.
limit_conn_zone $binary_remote_addr zone=directlink_perip:10m;
limit_conn_zone $server_name zone=directlink_site:1m;
server {
    listen 80;
    server_name __DOMAIN__;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__TLS_CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__TLS_CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 9m;
    client_body_timeout 300s;
    send_timeout 300s;
    limit_conn_status 429;
    location /static/ {
        alias /opt/direct-link-site/staticfiles/;
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 600s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
    location /f/ {
        limit_conn directlink_perip 12;
        limit_conn directlink_site 48;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }
    location /_protected_files/ { return 404; }
}
