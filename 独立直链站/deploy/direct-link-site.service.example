[Unit]
Description=Independent direct link file station
After=network.target

[Service]
User=directlink
Group=directlink
WorkingDirectory=/opt/direct-link-site
EnvironmentFile=/opt/direct-link-site/.env
ExecStart=/opt/direct-link-site/.venv/bin/gunicorn directsite.wsgi:application --bind 127.0.0.1:18081 --workers 2 --threads 8 --timeout 600 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/direct-link-site/data

[Install]
WantedBy=multi-user.target
